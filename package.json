{
  "name": "@astrona-io/perses-plugin-geomap",
  "version": "0.2.1",
  "scripts": {
    "dev": "rsbuild dev",
    "build": "npm run build-mf && concurrently \"npm:build:*\"",
    "build-mf": "rsbuild build",
    "build:cjs": "swc ./src -d dist/lib/cjs --strip-leading-paths --config-file .cjs.swcrc --copy-files",
    "build:esm": "swc ./src -d dist/lib --strip-leading-paths --config-file .swcrc --copy-files",
    "build:types": "tsc --project tsconfig.build.json",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "cross-env LC_ALL=C TZ=UTC jest --passWithNoTests",
    "type-check": "tsc --noEmit",
    "world-data": "node scripts/build-world-data.mjs"
  },
  "main": "lib/cjs/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "devDependencies": {
    "@module-federation/rsbuild-plugin": "^2.9.3",
    "@rsbuild/core": "^1.7.6",
    "@rsbuild/plugin-react": "^1.4.6",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/geojson": "^7946.0.16",
    "@types/jest": "^29.5.14",
    "@types/react-dom": "^18.3.0",
    "@types/topojson-client": "^3.1.5",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "i18n-iso-countries": "^7.14.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.26.0",
    "topojson-simplify": "^3.0.3",
    "world-atlas": "^2.0.2"
  },
  "peerDependencies": {
    "@emotion/react": "^11.7.1",
    "@emotion/styled": "^11.6.0",
    "@hookform/resolvers": "^3.2.0 || ^7.0.0",
    "@mui/material": "^6.1.10",
    "@perses-dev/client": "^0.54.0 || ^0.55.0",
    "@perses-dev/components": "^0.54.0 || ^0.55.0",
    "@perses-dev/dashboards": "^0.54.0 || ^0.55.0",
    "@perses-dev/explore": "^0.54.0 || ^0.55.0",
    "@perses-dev/plugin-system": "^0.54.0",
    "@perses-dev/spec": "^0.2.0",
    "@tanstack/react-query": "^4.39.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "echarts": "5.5.0",
    "immer": "^10.1.1",
    "lodash": "^4.17.21",
    "react": "^17.0.2 || ^18.0.0",
    "react-dom": "^17.0.2 || ^18.0.0",
    "react-hook-form": "^7.52.2",
    "use-resize-observer": "^9.0.0"
  },
  "files": [
    "lib/**/*",
    "__mf/**/*",
    "mf-manifest.json",
    "mf-stats.json"
  ],
  "perses": {
    "metadata": {
      "name": "Geomap",
      "registry": "astrona-io"
    },
    "schemasPath": "schemas",
    "plugins": [
      {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Geo map"
          },
          "name": "GeoMapChart"
        }
      }
    ]
  },
  "dependencies": {
    "topojson-client": "^3.1.0"
  },
  "description": "Perses panel plugin: world map (choropleth by country) over a time-series query",
  "license": "Apache-2.0",
  "author": "Astrona",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astrona-io/perses-plugin-geomap.git"
  },
  "homepage": "https://github.com/astrona-io/perses-plugin-geomap#readme",
  "bugs": {
    "url": "https://github.com/astrona-io/perses-plugin-geomap/issues"
  },
  "keywords": [
    "perses",
    "plugin",
    "geomap",
    "choropleth",
    "world-map",
    "prometheus"
  ]
}
